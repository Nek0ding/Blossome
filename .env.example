# Salin file ini menjadi .env.local lalu isi nilai yang masih kosong.
# Windows (PowerShell/CMD):  copy .env.example .env.local

# Supabase project "blossome". URL dan publishable key memang aman untuk publik.
NEXT_PUBLIC_SUPABASE_URL=https://sjfxnamddrbfawvpcysj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_eAbY-Yb3c7fsUb7zDH7hwg_1Ml5R9KS
# WAJIB: kunci rahasia (Project Settings > API Keys > secret / service_role). Hanya dipakai di server. Jangan dibagikan.
SUPABASE_SERVICE_ROLE_KEY=

# Alamat website. Lokal: http://localhost:3000. Setelah deploy: https://nama-projek.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WAJIB: Midtrans sandbox (dashboard.sandbox.midtrans.com > Settings > Access Keys > Server Key)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Email (opsional). Kalau kosong, email tidak dikirim tapi website tetap jalan.
# Contoh Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS=app password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Blossomé <alamat@email.com>"
